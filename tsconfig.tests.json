{
  "compilerOptions": {
    "target": "ES2021",
    "module": "CommonJS",
    "lib": ["ES2021"],
    "strict": true,
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": ".tests-build",
    "rootDir": "src/v2",
    "types": []
  },
  "include": ["src/v2/core", "src/v2/data", "src/v2/state", "src/v2/tests"]
}
